# Generated protobuf bindings (regenerate with `make generate-proto`)
/proto/controller_agent/*.pb.go

# Build outputs
/bin/
/dist/
/zig/zig-out/
/zig/.zig-cache/
/tmp/
*.test
coverage.out
/vendor/

# Local tool state
/.claude/
/.specstory/

# Local observability stack env overrides (copy of .env.example; may pin
# image tags per-machine, never commit local secrets)
/deploy/observability/.env

# Python bytecode
__pycache__/

# Compiled eBPF objects of the service tracer are committed (see
# internal/agent/servicetrace/generate.go), so a global *.o ignore must not
# hide them.
!/internal/agent/servicetrace/*.o
